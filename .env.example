# Copy this file to .env.local and fill in from Supabase: Project Settings > API.
# The anon key is safe in the browser because Row Level Security protects every table.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Live bank sync (optional): Lunch Flow → Destinations → REST API key.
# Server-only: never prefix with NEXT_PUBLIC_.
LUNCHFLOW_API_KEY=

# Server-only. Lets the watch webhook write data. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI coach. Free key from aistudio.google.com. Server-only.
AI_API_KEY=
# Optional: switch model or provider (any OpenAI-compatible API)
# AI_MODEL=gemini-3.8-flash
# AI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional free backups, tried in this order when Gemini is busy. Server-only.
# NVIDIA: build.nvidia.com (free, 40 requests a minute). Groq: console.groq.com (free).
NVIDIA_API_KEY=
GROQ_API_KEY=
# Last resorts with small free allowances:
# OPENROUTER_API_KEY=
# HF_TOKEN=

# Optional: lets the assistant search the web to check rules and costs. Free at tavily.com.
TAVILY_API_KEY=
