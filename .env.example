# Copy this file to .env.local and fill in from Supabase: Project Settings > API.
# The anon key is safe in the browser because Row Level Security protects every table.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Live bank sync (optional): from your Enable Banking production app.
# Server-only: never prefix these with NEXT_PUBLIC_.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
